# Server-only. Never prefix with NEXT_PUBLIC_. Set a spend/credit limit on this key.
OPENROUTER_API_KEY=
# A model that supports structured outputs, e.g. openai/gpt-4o-mini (verify at https://openrouter.ai/api/v1/models)
OPENROUTER_MODEL=
# Absolute public URL, used for metadata, sitemap and the same-origin check
NEXT_PUBLIC_APP_URL=
# Optional
# NEXT_PUBLIC_APP_NAME=ResumeRoom
# RATE_LIMIT_GENERATE_PER_HOUR=5
# RATE_LIMIT_EVALUATE_PER_HOUR=30
